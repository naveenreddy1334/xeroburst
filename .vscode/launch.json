{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "XeroBurst server (debug)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/server",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["tsx", "src/index.ts"],
      "env": { "BOARD_SIM": "1" },
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
