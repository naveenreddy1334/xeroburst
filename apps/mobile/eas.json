{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    "phone-apk": {
      "distribution": "internal",
      "autoIncrement": true,
      "android": { "buildType": "apk" }
    },
    "tv-apk": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "EXPO_TV": "1" }
    },
    "production": { "autoIncrement": true }
  }
}
